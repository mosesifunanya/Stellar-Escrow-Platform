{
  "name": "stellarchain-backend",
  "version": "1.0.0",
  "description": "Backend API for StellarChain",
  "main": "src/app.ts",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm src/server.ts",
    "build": "npm install --prefix src/contract-client && npm run build --prefix src/contract-client && node -e \"require('fs').cpSync('src/contract-client/dist','src/contract-client-runtime',{recursive:true})\" && tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.3.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
